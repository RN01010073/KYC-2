# ═════════════════════════════════════════════════════════════════════════════
# Environment Configuration for VerifyZ
# ═════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the actual values.
# .env is ignored by git (see .gitignore), so never commit real credentials here.

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL via Supabase or similar)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/dbname

# ─────────────────────────────────────────────────────────────────────────────
# Encryption Key (CRITICAL - must be kept secret)
# ─────────────────────────────────────────────────────────────────────────────
# Generate a new encryption key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Store this key securely. If lost, encrypted data cannot be recovered.
# Never share this key or commit it to version control.
ENCRYPTION_KEY=your_encryption_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Debug Endpoint Authentication (for /debug/applications)
# ─────────────────────────────────────────────────────────────────────────────
# These credentials protect the admin debug endpoint where encrypted KYC data
# can be viewed. Use a strong password.
DEBUG_USERNAME=admin
DEBUG_PASSWORD=your_strong_password_here

# ─────────────────────────────────────────────────────────────────────────────
# DigiLocker / MeriPehchaan OAuth2 Credentials
# ─────────────────────────────────────────────────────────────────────────────
# Obtain these from your API Setu dashboard (https://dashboard.setu.co)
DIGILOCKER_CLIENT_ID=your_client_id_here
DIGILOCKER_CLIENT_SECRET=your_client_secret_here
DIGILOCKER_REDIRECT_URI=http://localhost:8000/digilocker/callback

# ─────────────────────────────────────────────────────────────────────────────
# File Upload Directory
# ─────────────────────────────────────────────────────────────────────────────
# Where encrypted uploaded files are stored on disk. Default: static/uploads
# All files in this directory are encrypted before being written.
UPLOAD_DIR=static/uploads

# ─────────────────────────────────────────────────────────────────────────────
# Server Port
# ─────────────────────────────────────────────────────────────────────────────
# Port to run the FastAPI server on. Default: 8000
PORT=8000